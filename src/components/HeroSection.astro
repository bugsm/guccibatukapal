---
---

<section class="hero-section" id="beranda">
	<!-- Top Area: Pure White Background -->
	<div class="hero-top-area">
		<div class="container">
			<div class="hero-grid">
				<!-- Left Column: Editorial Copy & CTAs -->
				<div class="hero-content">
					<div class="badge-tag">
						<span class="badge-dot"></span>
						<span>DESA MAJA, KALIANDA — LAMPUNG SELATAN</span>
					</div>

					<h1 class="hero-title">
						Recharge.<br />
						<em>Reconnect.</em>
					</h1>

					<p class="hero-subtitle">
						Pantai pasir putih alami yang tenang dan aman untuk keluarga, dengan panorama sunset spektakuler dan petualangan camping private di bawah pohon rindang pesisir Kalianda.
					</p>

					<div class="hero-buttons">
						<a href="#tentang" class="btn-primary">
							Jelajahi Pantai
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<line x1="5" y1="12" x2="19" y2="12"></line>
								<polyline points="12 5 19 12 12 19"></polyline>
							</svg>
						</a>
						<a href="#harga" class="btn-secondary">
							Paket Camping
						</a>
					</div>

					<!-- Social Proof Rating -->
					<div class="hero-rating">
						<div class="avatar-stack">
							<img src={`\${import.meta.env.BASE_URL}images/IMG_3244.jpg`} alt="Visitor 1" class="avatar-img" />
							<img src={`\${import.meta.env.BASE_URL}images/IMG_3190.jpg`} alt="Visitor 2" class="avatar-img" />
							<img src={`\${import.meta.env.BASE_URL}images/IMG_3208.jpg`} alt="Visitor 3" class="avatar-img" />
							<img src={`\${import.meta.env.BASE_URL}images/IMG_3257.jpg`} alt="Visitor 4" class="avatar-img" />
						</div>
						<div class="rating-info">
							<div class="stars">★★★★★</div>
							<span class="rating-text"><strong>4.9/5</strong> Dipercaya oleh 5.000+ Pengunjung</span>
						</div>
					</div>
				</div>

				<!-- Right Column: Precision Clipped Seamless Nature Video -->
				<div class="hero-media-wrapper">
					<div class="media-card">
						<video
							class="hero-video"
							autoplay
							muted
							loop
							playsinline
							disablepictureinpicture
							controlslist="nodownload nofullscreen noremoteplayback"
							oncontextmenu="return false;"
							preload="auto"
							poster="/images/IMG_3190.jpg"
						>
							<source src={`\${import.meta.env.BASE_URL}herosection.mp4`} type="video/mp4" />
						</video>
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- Wave Transition Divider: Pure White to Soft Gray (#f4f5f1) -->
	<div class="wave-transition">
		<svg viewBox="0 0 1440 65" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
			<path d="M0,20 C360,60 680,5 1040,42 C1240,62 1380,18 1440,28 L1440,65 L0,65 Z" fill="#f4f5f1"></path>
		</svg>
	</div>

	<!-- Bottom Area: Soft Contrasting Background with Rounded White Card -->
	<div class="hero-bottom-area" id="pengalaman">
		<div class="container">
			<div class="features-bar">
				<!-- 4 Core Pillars of Pantai Guci Batu Kapal -->
				<div class="feature-item">
					<div class="feature-icon">
						<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
							<path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/>
						</svg>
					</div>
					<h3>Pantai Pasir Putih</h3>
					<p>Hamparan pasir putih alami di bawah naungan pohon pesisir yang teduh dan asri.</p>
				</div>

				<div class="feature-item">
					<div class="feature-icon">
						<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
							<path d="M2 18c2-1 4-1 6 0s4 1 6 0 4-1 6 0"/>
							<path d="M2 14c2-1 4-1 6 0s4 1 6 0 4-1 6 0"/>
							<path d="M2 10c2-1 4-1 6 0s4 1 6 0 4-1 6 0"/>
						</svg>
					</div>
					<h3>Aman untuk Berenang</h3>
					<p>Air laut jernih, dangkal, dan tenang — sangat aman untuk rekreasi renang keluarga & anak.</p>
				</div>

				<div class="feature-item">
					<div class="feature-icon">
						<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
							<circle cx="12" cy="12" r="4"/>
							<path d="M12 2v2"/>
							<path d="M12 20v2"/>
							<path d="m4.93 4.93 1.41 1.41"/>
							<path d="m17.66 17.66 1.41 1.41"/>
							<path d="M2 12h2"/>
							<path d="M20 12h2"/>
						</svg>
					</div>
					<h3>Ikon Tebing Batu Kapal</h3>
					<p>Formasi batu karang legendaris menyerupai kapal dengan latar golden sunset spektakuler.</p>
				</div>

				<div class="feature-item">
					<div class="feature-icon">
						<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
							<path d="m19 20-7-14-7 14"/>
							<path d="m7 16 5-3 5 3"/>
						</svg>
					</div>
					<h3>Area Private Camping</h3>
					<p>Bisa kemping di tepi pantai, nikmati malam berbintang, gathering keluarga & honeymoon.</p>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.hero-section {
		display: flex;
		flex-direction: column;
		width: 100%;
		background: #ffffff;
	}

	/* Top Area: Pure White */
	.hero-top-area {
		background: #ffffff;
		padding: clamp(2.5rem, 5vw, 4.5rem) 0 2rem;
		width: 100%;
	}

	.hero-grid {
		display: grid;
		grid-template-columns: 1fr 1.35fr;
		gap: clamp(2rem, 4vw, 3.5rem);
		align-items: center;
	}

	/* Left Column */
	.hero-content {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
	}

	.badge-tag {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		color: var(--brand-accent);
		background: rgba(45, 90, 82, 0.08);
		padding: 0.35rem 0.85rem;
		border-radius: var(--radius-full);
		margin-bottom: 1.5rem;
	}

	.badge-dot {
		width: 6px;
		height: 6px;
		background-color: var(--brand-primary);
		border-radius: 50%;
	}

	.hero-title {
		font-size: clamp(3rem, 6vw, 4.8rem);
		font-weight: 600;
		color: var(--text-title);
		line-height: 1.05;
		margin-bottom: 1.5rem;
		letter-spacing: -0.02em;
	}

	.hero-title em {
		font-style: italic;
		font-weight: 400;
		color: var(--brand-primary);
	}

	.hero-subtitle {
		font-size: clamp(1rem, 1.3vw, 1.15rem);
		color: var(--text-body);
		line-height: 1.65;
		margin-bottom: 2rem;
		max-width: 480px;
	}

	.hero-buttons {
		display: flex;
		align-items: center;
		gap: 1rem;
		flex-wrap: wrap;
		margin-bottom: 2.5rem;
	}

	.btn-primary {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		background-color: var(--brand-primary);
		color: #ffffff;
		padding: 0.85rem 1.8rem;
		border-radius: var(--radius-full);
		font-size: 0.95rem;
		font-weight: 600;
		letter-spacing: 0.01em;
		box-shadow: 0 4px 14px rgba(30, 58, 52, 0.2);
	}

	.btn-primary:hover {
		background-color: var(--brand-dark);
		transform: translateY(-2px);
		box-shadow: 0 6px 20px rgba(30, 58, 52, 0.28);
	}

	.btn-secondary {
		display: inline-flex;
		align-items: center;
		background: #ffffff;
		color: var(--text-title);
		border: 1px solid var(--border-subtle);
		padding: 0.85rem 1.8rem;
		border-radius: var(--radius-full);
		font-size: 0.95rem;
		font-weight: 600;
	}

	.btn-secondary:hover {
		border-color: var(--border-focus);
		background-color: #f4f5f1;
		transform: translateY(-1px);
	}

	/* Social Proof Rating */
	.hero-rating {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.avatar-stack {
		display: flex;
		align-items: center;
	}

	.avatar-img {
		width: 38px;
		height: 38px;
		border-radius: 50%;
		border: 2.5px solid #ffffff;
		object-fit: cover;
		margin-left: -10px;
	}

	.avatar-img:first-child {
		margin-left: 0;
	}

	.rating-info {
		display: flex;
		flex-direction: column;
		line-height: 1.25;
	}

	.stars {
		color: #eab308;
		font-size: 0.95rem;
		letter-spacing: 1px;
	}

	.rating-text {
		font-size: 0.82rem;
		color: var(--text-body);
	}

	.rating-text strong {
		color: var(--text-title);
	}

	/* Right Column: Seamless Large Island Video with Zero Edge Artifacts */
	.hero-media-wrapper {
		position: relative;
		display: flex;
		justify-content: center;
		align-items: center;
		width: 100%;
		padding: 1rem 0;
	}

	.media-card {
		position: relative;
		width: 100%;
		max-width: 680px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: #ffffff;
		border: none;
		outline: none;
	}

	.hero-video {
		width: 120%;
		height: auto;
		max-height: 580px;
		object-fit: contain;
		display: block;
		background: #ffffff;
		border: none;
		outline: none;
		/* Clip 16.5% to strictly eliminate the 1px thin edge line on left & right */
		clip-path: inset(0 16.5% 0 16.5%);
		margin: 0 -16.5%;
		pointer-events: none;
		user-select: none;
		-webkit-user-select: none;
		transform: scale(1.08);
	}

	/* Wave Transition Divider */
	.wave-transition {
		width: 100%;
		background: #ffffff;
		line-height: 0;
		font-size: 0;
		position: relative;
		z-index: 2;
		margin-bottom: -3px;
	}

	.wave-transition svg {
		display: block;
		width: 100%;
		height: 55px;
	}

	/* Bottom Area: Exactly matching wave color #f4f5f1 */
	.hero-bottom-area {
		background-color: #f4f5f1;
		position: relative;
		z-index: 1;
		padding: 1rem 0 clamp(3.5rem, 6vw, 5rem);
		width: 100%;
	}

	/* 4 Features Bar (Rounded Card matching reference) */
	.features-bar {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1.5rem;
		background: #ffffff;
		border: 1px solid rgba(0, 0, 0, 0.04);
		border-radius: 28px;
		padding: 2.5rem 2.25rem;
		box-shadow: 0 4px 25px rgba(0, 0, 0, 0.03);
	}

	.feature-item {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
	}

	.feature-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		border-radius: 12px;
		background-color: #f4f5f1;
		color: var(--brand-primary);
		margin-bottom: 1rem;
	}

	.feature-item h3 {
		font-size: 1.1rem;
		font-weight: 600;
		color: var(--text-title);
		margin-bottom: 0.4rem;
	}

	.feature-item p {
		font-size: 0.85rem;
		color: var(--text-muted);
		line-height: 1.5;
	}

	@media (max-width: 960px) {
		.hero-grid {
			grid-template-columns: 1fr;
		}

		.features-bar {
			grid-template-columns: repeat(2, 1fr);
			gap: 2rem;
		}

		.wave-transition svg {
			height: 35px;
		}
	}

	@media (max-width: 600px) {
		.features-bar {
			grid-template-columns: 1fr;
			padding: 1.75rem;
			border-radius: 20px;
		}
	}
</style>
