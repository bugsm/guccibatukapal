---
---

<section class="pricing-section" id="harga">
	<div class="container">
		<div class="section-heading">
			<span class="heading-badge">TARIF & PAKET</span>
			<h2>Harga Tiket & Camping</h2>
			<p>Akses wisata pantai terjangkau dengan fasilitas alami yang lengkap</p>
		</div>

		<div class="pricing-cards-grid">
			<!-- Tiket Reguler -->
			<div class="price-card">
				<div class="card-top">
					<span class="plan-type">TIKET MASUK</span>
					<h3>Wisata Reguler</h3>
					<p class="plan-desc">Akses pantai & spot foto untuk pengunjung perorangan/keluarga.</p>
				</div>

				<div class="pricing-items">
					<div class="p-item">
						<div>
							<span class="item-name">Dewasa</span>
							<span class="item-sub">Per orang</span>
						</div>
						<div class="item-cost">Rp 15.000</div>
					</div>

					<div class="p-item">
						<div>
							<span class="item-name">Anak-anak</span>
							<span class="item-sub">Usia di atas 5 tahun</span>
						</div>
						<div class="item-cost">Rp 10.000</div>
					</div>
				</div>

				<div class="card-bottom">
					<div class="notice-badge">ℹ️ Anak usia di atas 5 tahun dihitung 1 tiket masuk</div>
				</div>
			</div>

			<!-- Group / Rombongan (Featured) -->
			<div class="price-card card-featured">
				<div class="featured-tag">BEST VALUE</div>
				<div class="card-top">
					<span class="plan-type">GROUP PACKAGE</span>
					<h3>Rombongan & Bus</h3>
					<p class="plan-desc">Khusus rombongan travel / instansi min. 40-60 pax.</p>
				</div>

				<div class="featured-perk">
					<div class="perk-highlight">
						<span class="perk-label">Bonus Khusus Group</span>
						<span class="perk-val">FREE 5 ORANG</span>
					</div>
				</div>

				<div class="perk-list">
					<span class="perk-title">Servis Khusus Driver & Kondektur Bus:</span>
					<ul>
						<li>✓ Gratis Tiket Masuk (HTM)</li>
						<li>✓ Gratis Makan untuk kru</li>
						<li>✓ Gratis Kopi & Rokok</li>
					</ul>
				</div>

				<div class="card-bottom">
					<a href="https://wa.me/6285199709926?text=Halo%20Admin%20Pantai%20Guci%20Batu%20Kapal,%20saya%20ingin%20booking%20rombongan" target="_blank" rel="noopener noreferrer" class="btn-card-action">
						Reservasi Rombongan
					</a>
				</div>
			</div>

			<!-- Camping Private -->
			<div class="price-card">
				<div class="card-top">
					<span class="plan-type">OVERNIGHT RETREAT</span>
					<h3>Camping Private</h3>
					<p class="plan-desc">Camp family, gathering, atau honeymoon camp tepi pantai.</p>
				</div>

				<div class="pricing-items">
					<div class="p-item">
						<div>
							<span class="item-name">Min. 10 Orang</span>
							<span class="item-sub">Per orang / malam</span>
						</div>
						<div class="item-cost">Rp 35.000</div>
					</div>

					<div class="p-item">
						<div>
							<span class="item-name">Di Bawah 10 Orang</span>
							<span class="item-sub">Per orang / malam</span>
						</div>
						<div class="item-cost">Rp 50.000</div>
					</div>
				</div>

				<div class="card-bottom">
					<a href="https://wa.me/6285199709926?text=Halo%20Admin%20Pantai%20Guci%20Batu%20Kapal,%20saya%20ingin%20booking%20camping" target="_blank" rel="noopener noreferrer" class="btn-card-outline">
						Booking Camping
					</a>
				</div>
			</div>
		</div>

		<!-- Parking Bar -->
		<div class="parking-summary">
			<div class="parking-intro">
				<span class="parking-icon">🅿️</span>
				<div>
					<h4>Tarif Parkir Kendaraan</h4>
					<p>Area parkir luas & aman langsung dekat akses pantai</p>
				</div>
			</div>
			<div class="parking-tiers">
				<div class="tier">
					<span class="tier-name">Motor</span>
					<span class="tier-price">Rp 3.000</span>
				</div>
				<div class="tier">
					<span class="tier-name">Mobil Pribadi</span>
					<span class="tier-price">Rp 5.000</span>
				</div>
				<div class="tier">
					<span class="tier-name">Bus Pariwisata</span>
					<span class="tier-price">Rp 20.000</span>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.pricing-section {
		padding: clamp(4rem, 7vw, 6rem) 0;
		background: var(--bg-main);
	}

	.section-heading {
		text-align: center;
		margin-bottom: 3.5rem;
	}

	.heading-badge {
		display: inline-block;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		color: var(--brand-accent);
		margin-bottom: 0.5rem;
	}

	.section-heading h2 {
		font-size: clamp(2rem, 4vw, 2.8rem);
		color: var(--text-title);
		margin-bottom: 0.75rem;
	}

	.section-heading p {
		font-size: 1rem;
		color: var(--text-muted);
		max-width: 540px;
		margin: 0 auto;
	}

	.pricing-cards-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
		align-items: stretch;
		margin-bottom: 2.5rem;
	}

	.price-card {
		background: #ffffff;
		border: 1px solid var(--border-subtle);
		border-radius: var(--radius-lg);
		padding: 2rem;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		position: relative;
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}

	.price-card:hover {
		transform: translateY(-3px);
		box-shadow: 0 12px 30px rgba(0, 0, 0, 0.05);
	}

	.card-featured {
		border-color: var(--brand-primary);
		background: #ffffff;
		box-shadow: 0 15px 35px -10px rgba(30, 58, 52, 0.15);
	}

	.featured-tag {
		position: absolute;
		top: -12px;
		right: 24px;
		background: var(--brand-primary);
		color: #ffffff;
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		padding: 0.3rem 0.8rem;
		border-radius: var(--radius-full);
	}

	.card-top {
		margin-bottom: 1.5rem;
	}

	.plan-type {
		display: block;
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		color: var(--text-muted);
		margin-bottom: 0.4rem;
	}

	.card-top h3 {
		font-size: 1.4rem;
		color: var(--text-title);
		margin-bottom: 0.5rem;
	}

	.plan-desc {
		font-size: 0.85rem;
		color: var(--text-muted);
		line-height: 1.5;
	}

	.pricing-items {
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
		margin-bottom: 1.5rem;
	}

	.p-item {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.85rem 1rem;
		background: var(--bg-subtle);
		border-radius: var(--radius-sm);
	}

	.item-name {
		display: block;
		font-size: 0.88rem;
		font-weight: 600;
		color: var(--text-title);
	}

	.item-sub {
		display: block;
		font-size: 0.72rem;
		color: var(--text-muted);
	}

	.item-cost {
		font-family: var(--font-sans);
		font-weight: 700;
		font-size: 1.05rem;
		color: var(--brand-primary);
	}

	.featured-perk {
		background: rgba(45, 90, 82, 0.08);
		border-radius: var(--radius-sm);
		padding: 1rem;
		margin-bottom: 1.25rem;
	}

	.perk-highlight {
		display: flex;
		flex-direction: column;
		text-align: center;
	}

	.perk-label {
		font-size: 0.75rem;
		font-weight: 600;
		color: var(--brand-accent);
	}

	.perk-val {
		font-family: var(--font-serif);
		font-size: 1.25rem;
		font-weight: 700;
		color: var(--brand-primary);
	}

	.perk-list {
		margin-bottom: 1.5rem;
	}

	.perk-title {
		display: block;
		font-size: 0.82rem;
		font-weight: 600;
		color: var(--text-title);
		margin-bottom: 0.5rem;
	}

	.perk-list ul {
		list-style: none;
		font-size: 0.82rem;
		color: var(--text-body);
		line-height: 1.7;
	}

	.notice-badge {
		font-size: 0.78rem;
		color: var(--text-muted);
		background: var(--bg-subtle);
		padding: 0.6rem 0.8rem;
		border-radius: var(--radius-sm);
		line-height: 1.4;
	}

	.btn-card-action {
		display: block;
		text-align: center;
		background: var(--brand-primary);
		color: #ffffff;
		font-weight: 600;
		font-size: 0.88rem;
		padding: 0.75rem 1rem;
		border-radius: var(--radius-full);
	}

	.btn-card-action:hover {
		background: var(--brand-dark);
	}

	.btn-card-outline {
		display: block;
		text-align: center;
		background: #ffffff;
		border: 1px solid var(--border-subtle);
		color: var(--text-title);
		font-weight: 600;
		font-size: 0.88rem;
		padding: 0.75rem 1rem;
		border-radius: var(--radius-full);
	}

	.btn-card-outline:hover {
		border-color: var(--brand-primary);
		color: var(--brand-primary);
	}

	/* Parking Summary */
	.parking-summary {
		background: #ffffff;
		border: 1px solid var(--border-subtle);
		border-radius: var(--radius-lg);
		padding: 1.5rem 2rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
	}

	.parking-intro {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.parking-icon {
		font-size: 1.6rem;
	}

	.parking-intro h4 {
		font-family: var(--font-sans);
		font-weight: 700;
		font-size: 0.95rem;
		color: var(--text-title);
	}

	.parking-intro p {
		font-size: 0.82rem;
		color: var(--text-muted);
	}

	.parking-tiers {
		display: flex;
		align-items: center;
		gap: 2rem;
	}

	.tier {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
	}

	.tier-name {
		font-size: 0.75rem;
		color: var(--text-muted);
	}

	.tier-price {
		font-weight: 700;
		font-size: 0.95rem;
		color: var(--brand-primary);
	}

	@media (max-width: 900px) {
		.pricing-cards-grid {
			grid-template-columns: 1fr;
		}

		.parking-summary {
			flex-direction: column;
			align-items: flex-start;
		}

		.parking-tiers {
			width: 100%;
			justify-content: space-between;
			gap: 1rem;
		}

		.tier {
			align-items: flex-start;
		}
	}
</style>
