---
---

<header class="site-header">
	<div class="container nav-wrapper">
		<a href={import.meta.env.BASE_URL} class="nav-brand">
			<img src={`${import.meta.env.BASE_URL}/logobaraqbah.svg`} alt="Logo Baraqbah Beach Nature" class="brand-logo-img" />
			<div class="brand-name-group">
				<span class="brand-title">BARAQBAH</span>
				<span class="brand-sub">BEACH NATURE</span>
			</div>
		</a>

		<nav class="nav-menu">
			<a href="#beranda" class="nav-item">Beranda</a>
			<a href="#tentang" class="nav-item">Tentang</a>
			<a href="#pengalaman" class="nav-item">Pengalaman</a>
			<a href="#harga" class="nav-item">Harga & Camp</a>
			<a href="#galeri" class="nav-item">Galeri</a>
			<a href="#lokasi" class="nav-item">Lokasi</a>
		</nav>

		<div class="nav-action">
			<a href={`${import.meta.env.BASE_URL}/links`} class="btn-book">Hubungi Kami</a>
		</div>

		<!-- Mobile Hamburger -->
		<button class="menu-toggle" id="mobileMenuBtn" aria-label="Toggle navigation">
			<span></span>
			<span></span>
		</button>
	</div>

	<!-- Mobile Dropdown -->
	<div class="mobile-nav" id="mobileNav">
		<a href="#beranda" class="mobile-link">Beranda</a>
		<a href="#tentang" class="mobile-link">Tentang</a>
		<a href="#pengalaman" class="mobile-link">Pengalaman</a>
		<a href="#harga" class="mobile-link">Harga & Camp</a>
		<a href="#galeri" class="mobile-link">Galeri</a>
		<a href="#lokasi" class="mobile-link">Lokasi</a>
		<a href={`${import.meta.env.BASE_URL}/links`} class="mobile-btn">Hubungi Kami</a>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 100;
		background: #ffffff;
		border-bottom: 1px solid #f0f0ee;
		padding: 1.1rem 0;
	}

	.nav-wrapper {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.nav-brand {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.brand-logo-img {
		width: 38px;
		height: 38px;
		object-fit: contain;
		display: block;
	}

	.brand-name-group {
		display: flex;
		flex-direction: column;
	}

	.brand-title {
		font-family: var(--font-serif);
		font-weight: 700;
		font-size: 1.05rem;
		letter-spacing: 0.08em;
		color: var(--brand-dark);
		line-height: 1.1;
	}

	.brand-sub {
		font-size: 0.65rem;
		font-weight: 600;
		letter-spacing: 0.18em;
		color: var(--text-muted);
	}

	.nav-menu {
		display: flex;
		align-items: center;
		gap: 2rem;
	}

	.nav-item {
		font-size: 0.9rem;
		font-weight: 500;
		color: var(--text-body);
		position: relative;
	}

	.nav-item:hover {
		color: var(--brand-primary);
	}

	.btn-book {
		display: inline-flex;
		align-items: center;
		padding: 0.65rem 1.4rem;
		border-radius: var(--radius-full);
		background-color: var(--brand-primary);
		color: #ffffff;
		font-size: 0.88rem;
		font-weight: 600;
		letter-spacing: 0.02em;
	}

	.btn-book:hover {
		background-color: var(--brand-dark);
		transform: translateY(-1px);
		box-shadow: 0 4px 12px rgba(21, 41, 38, 0.15);
	}

	.menu-toggle {
		display: none;
		flex-direction: column;
		gap: 6px;
		background: none;
		border: none;
		cursor: pointer;
		padding: 0.25rem;
	}

	.menu-toggle span {
		display: block;
		width: 22px;
		height: 2px;
		background-color: var(--brand-dark);
		border-radius: 2px;
		transition: 0.3s;
	}

	.mobile-nav {
		display: none;
		flex-direction: column;
		background: #ffffff;
		border-bottom: 1px solid var(--border-subtle);
		padding: 1.25rem 1.5rem;
		gap: 1rem;
	}

	.mobile-nav.open {
		display: flex;
	}

	.mobile-link {
		font-size: 1rem;
		font-weight: 500;
		color: var(--text-title);
		padding: 0.25rem 0;
	}

	.mobile-btn {
		display: inline-block;
		text-align: center;
		background: var(--brand-primary);
		color: #ffffff;
		padding: 0.75rem 1rem;
		border-radius: var(--radius-full);
		font-weight: 600;
		font-size: 0.9rem;
		margin-top: 0.5rem;
	}

	@media (max-width: 860px) {
		.nav-menu, .nav-action {
			display: none;
		}
		.menu-toggle {
			display: flex;
		}
	}
</style>

<script>
	const btn = document.getElementById('mobileMenuBtn');
	const nav = document.getElementById('mobileNav');

	btn?.addEventListener('click', () => {
		nav?.classList.toggle('open');
	});

	const mobileLinks = document.querySelectorAll('.mobile-link');
	mobileLinks.forEach(link => {
		link.addEventListener('click', () => nav?.classList.remove('open'));
	});
</script>
