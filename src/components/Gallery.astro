---
const galleryItems = [
	{
		src: `${import.meta.env.BASE_URL}/images/IMG_3244.jpg`,
		title: 'Sunset di Tebing Karang Batu Kapal',
		desc: 'Siluet megah gugusan batu karang ikonik dengan bendera saat matahari terbenam keemasan.'
	},
	{
		src: `${import.meta.env.BASE_URL}/images/IMG_3190.jpg`,
		title: 'Kesejukan Teduh Pesisir Maja',
		desc: 'Rindangnya pepohonan pantai yang asri berpadu dengan air laut bening dan bebatuan alami.'
	},
	{
		src: `${import.meta.env.BASE_URL}/images/IMG_3182.jpg`,
		title: 'Wonderful Natural Beach',
		desc: 'Ikon kayu selamat datang dengan sentuhan khas Lampung Selatan di tepian pantai.'
	},
	{
		src: `${import.meta.env.BASE_URL}/images/IMG_3208.jpg`,
		title: 'Biota Laut & Kelomang Alami',
		desc: 'Perairan dangkal yang sangat ramah anak untuk menemukan kelomang dan keanekaragaman laut.'
	},
	{
		src: `${import.meta.env.BASE_URL}/images/IMG_3229.jpg`,
		title: 'Pesona Karang Dangkal',
		desc: 'Air laut jernih kebiruan dengan formasi karang pesisir yang eksotis dan aman dijelajahi.'
	},
	{
		src: `${import.meta.env.BASE_URL}/images/IMG_3257.jpg`,
		title: 'Berenang Santai Saat Senja',
		desc: 'Momen menenangkan berenang di laut tenang dengan latar matahari terbenam sempurna.'
	}
];
---

<section class="gallery-section" id="galeri">
	<div class="container">
		<div class="gallery-header">
			<div>
				<span class="heading-badge">GALERI ASLI DESTINASI</span>
				<h2>Potret Keindahan Alami Pantai</h2>
			</div>
			<div class="gallery-social-actions">
				<a href="https://www.instagram.com/beachbaraqbah" target="_blank" rel="noopener noreferrer" class="btn-social-outline" aria-label="Instagram @beachbaraqbah">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
						<path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
						<line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
					</svg>
					@beachbaraqbah
				</a>
				<a href="https://www.tiktok.com/@pikabaraqbah04" target="_blank" rel="noopener noreferrer" class="btn-social-outline" aria-label="TikTok @pikabaraqbah04">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
						<path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64c.298-.002.595.042.88.13V9.4a6.33 6.33 0 0 0-1-.08A6.34 6.34 0 0 0 3 15.66a6.34 6.34 0 0 0 10.86 4.43V10.1a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-.04-1.53z"/>
					</svg>
					@pikabaraqbah04
				</a>
			</div>
		</div>

		<div class="gallery-grid">
			{galleryItems.map((item) => (
				<div class="gallery-card">
					<div class="image-wrapper">
						<img src={item.src} alt={item.title} loading="lazy" />
					</div>
					<div class="card-meta">
						<h4>{item.title}</h4>
						<p>{item.desc}</p>
					</div>
				</div>
			))}
		</div>
	</div>
</section>

<style>
	.gallery-section {
		padding: clamp(4rem, 7vw, 6rem) 0;
		background: #ffffff;
		border-top: 1px solid var(--border-subtle);
	}

	.gallery-header {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		margin-bottom: 3rem;
		gap: 1.5rem;
		flex-wrap: wrap;
	}

	.gallery-social-actions {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		flex-wrap: wrap;
	}

	.heading-badge {
		display: inline-block;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		color: var(--brand-accent);
		margin-bottom: 0.4rem;
	}

	.gallery-header h2 {
		font-size: clamp(2rem, 3.5vw, 2.6rem);
		color: var(--text-title);
	}

	.btn-social-outline {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		border: 1px solid var(--border-subtle);
		background: var(--bg-main);
		padding: 0.6rem 1.15rem;
		border-radius: var(--radius-full);
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--text-title);
		transition: all var(--transition-fast);
	}

	.btn-social-outline:hover {
		border-color: var(--brand-primary);
		color: var(--brand-primary);
		transform: translateY(-2px);
	}

	.gallery-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 2rem;
	}

	.gallery-card {
		display: flex;
		flex-direction: column;
		background: #ffffff;
		border-radius: var(--radius-md);
		overflow: hidden;
		transition: transform var(--transition-base);
	}

	.gallery-card:hover {
		transform: translateY(-4px);
	}

	.image-wrapper {
		width: 100%;
		height: 280px;
		overflow: hidden;
		border-radius: var(--radius-md);
		background-color: var(--bg-subtle);
	}

	.image-wrapper img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.gallery-card:hover .image-wrapper img {
		transform: scale(1.05);
	}

	.card-meta {
		padding: 1.25rem 0.25rem 0.5rem;
	}

	.card-meta h4 {
		font-size: 1.05rem;
		font-weight: 600;
		color: var(--text-title);
		margin-bottom: 0.4rem;
	}

	.card-meta p {
		font-size: 0.85rem;
		color: var(--text-muted);
		line-height: 1.5;
	}

	@media (max-width: 960px) {
		.gallery-grid {
			grid-template-columns: repeat(2, 1fr);
			gap: 1.5rem;
		}
	}

	@media (max-width: 600px) {
		.gallery-grid {
			grid-template-columns: 1fr;
		}

		.image-wrapper {
			height: 240px;
		}
	}
</style>
