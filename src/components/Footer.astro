---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer" id="lokasi">
	<div class="container">
		<div class="footer-top-grid">
			<!-- Brand Info -->
			<div class="footer-col brand-col">
				<div class="footer-brand">
					<img src={`${import.meta.env.BASE_URL}logobaraqbah.svg`} alt="Logo Baraqbah Beach Nature" class="footer-logo-img" />
					<div class="brand-titles">
						<span class="b-name">BARAQBAH BEACH NATURE</span>
						<span class="b-tag">Pantai Guci Batu Kapal</span>
					</div>
				</div>

				<p class="footer-desc">
					Surga pantai alami pasir putih yang terletak di Desa Maja, Kalianda, Kabupaten Lampung Selatan. Destinasi wisata keluarga, spot sunset, dan tempat camping private.
				</p>

				<div class="footer-social-links">
					<a href="https://wa.me/6285199709926" target="_blank" rel="noopener noreferrer" class="social-btn" aria-label="WhatsApp">
						WhatsApp
					</a>
					<a href="https://instagram.com/baraqbahbeachnature" target="_blank" rel="noopener noreferrer" class="social-btn" aria-label="Instagram">
						Instagram
					</a>
					<a href="mailto:baraqbahbeachnature@gmail.com" class="social-btn" aria-label="Email">
						Email
					</a>
				</div>
			</div>

			<!-- Quick Links -->
			<div class="footer-col links-col">
				<h5>Eksplorasi</h5>
				<ul>
					<li><a href="#beranda">Beranda</a></li>
					<li><a href="#tentang">Tentang Desa Maja</a></li>
					<li><a href="#pengalaman">Pengalaman & Fasilitas</a></li>
					<li><a href="#harga">Harga Tiket & Camping</a></li>
					<li><a href="#galeri">Galeri Foto</a></li>
					<li><a href={`${import.meta.env.BASE_URL}links`}>Kontak / Bio Links</a></li>
				</ul>
			</div>

			<!-- Contact & Map -->
			<div class="footer-col contact-col">
				<h5>Kontak & Reservasi</h5>
				<div class="contact-details">
					<p><strong>Admin:</strong> 0851-9970-9926 (Pika Baraqbah)</p>
					<p><strong>Email:</strong> baraqbahbeachnature@gmail.com</p>
					<p><strong>Instagram:</strong> @baraqbahbeachnature</p>
					<p><strong>Alamat:</strong> Jl. Pesisir Desa Maja, Kec. Kalianda, Kab. Lampung Selatan</p>
					<p><strong>Jam Operasional:</strong> 07.00 — 17.00 WIB (Buka Setiap Hari)</p>
				</div>
			</div>
		</div>

		<!-- Map Frame -->
		<div class="footer-map-wrapper">
			<iframe
				src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3971.3!2d105.6!3d-5.7!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2sPantai+Guci+Batu+Kapal!5e0!3m2!1sid!2sid!4v1"
				width="100%"
				height="220"
				style="border:0; border-radius: var(--radius-md);"
				allowfullscreen=""
				loading="lazy"
				referrerpolicy="no-referrer-when-downgrade"
				title="Peta Lokasi Pantai Guci Batu Kapal"
			></iframe>
		</div>

		<div class="footer-bottom">
			<p>© {currentYear} Baraqbah Beach Nature (Pantai Guci Batu Kapal). All rights reserved.</p>
			<p class="credit-dev">
				Made with <span class="heart">❤️</span> by <a href="https://deaal.dev" target="_blank" rel="noopener noreferrer" class="credit-link">deaal.dev</a>
			</p>
			<p class="tagline-sub">Beach Natural & Beautiful • Desa Maja, Kalianda, Lampung Selatan</p>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		background-color: var(--brand-dark);
		color: #e5e8e3;
		padding: 4.5rem 0 2.5rem;
	}

	.footer-top-grid {
		display: grid;
		grid-template-columns: 1.4fr 0.8fr 1.2fr;
		gap: clamp(2rem, 5vw, 4rem);
		margin-bottom: 3rem;
	}

	.footer-brand {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 1.25rem;
	}

	.footer-logo-img {
		width: 40px;
		height: 40px;
		object-fit: contain;
		display: block;
	}

	.brand-titles {
		display: flex;
		flex-direction: column;
	}

	.b-name {
		font-family: var(--font-serif);
		font-size: 1.05rem;
		font-weight: 700;
		color: #ffffff;
		letter-spacing: 0.06em;
	}

	.b-tag {
		font-size: 0.72rem;
		color: #9eb1ab;
	}

	.footer-desc {
		font-size: 0.88rem;
		color: #a4b3ae;
		line-height: 1.7;
		margin-bottom: 1.5rem;
	}

	.footer-social-links {
		display: flex;
		gap: 0.75rem;
	}

	.social-btn {
		font-size: 0.8rem;
		font-weight: 600;
		color: #ffffff;
		background: rgba(255, 255, 255, 0.08);
		padding: 0.45rem 1rem;
		border-radius: var(--radius-full);
		border: 1px solid rgba(255, 255, 255, 0.12);
	}

	.social-btn:hover {
		background: rgba(255, 255, 255, 0.18);
		color: #ffffff;
	}

	.footer-col h5 {
		font-family: var(--font-sans);
		font-size: 0.82rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: #ffffff;
		margin-bottom: 1.25rem;
	}

	.links-col ul {
		list-style: none;
	}

	.links-col li {
		margin-bottom: 0.6rem;
	}

	.links-col a {
		font-size: 0.88rem;
		color: #a4b3ae;
	}

	.links-col a:hover {
		color: #ffffff;
	}

	.contact-details {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		font-size: 0.85rem;
		color: #a4b3ae;
		line-height: 1.6;
	}

	.contact-details strong {
		color: #ffffff;
	}

	.footer-map-wrapper {
		margin-bottom: 3rem;
		border-radius: var(--radius-md);
		overflow: hidden;
		border: 1px solid rgba(255, 255, 255, 0.1);
	}

	.footer-bottom {
		padding-top: 2rem;
		border-top: 1px solid rgba(255, 255, 255, 0.08);
		display: flex;
		align-items: center;
		justify-content: space-between;
		font-size: 0.78rem;
		color: #7d8f8a;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.credit-dev {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		color: #9eb1ab;
	}

	.credit-link {
		color: #ffffff;
		font-weight: 600;
		text-decoration: underline;
		text-underline-offset: 3px;
		transition: color var(--transition-fast);
	}

	.credit-link:hover {
		color: #52c41a;
	}

	.heart {
		display: inline-block;
		margin: 0 0.15rem;
	}

	.tagline-sub {
		color: #5d706a;
	}

	@media (max-width: 860px) {
		.footer-top-grid {
			grid-template-columns: 1fr;
			gap: 2rem;
		}

		.footer-bottom {
			flex-direction: column;
			gap: 0.5rem;
			text-align: center;
		}
	}
</style>
